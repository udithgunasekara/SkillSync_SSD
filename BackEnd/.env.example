# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/SkillSync_DB?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_database_password
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DDL_AUTO=update
DB_SHOW_SQL=false
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# SMTP/Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=25MB
UPLOAD_FILE_SIZE_THRESHOLD=1MB
UPLOAD_LOCATION=${java.io.tmpdir}
UPLOAD_ENABLED=true

# Server Configuration
SERVER_PORT=8082

# Session Configuration (Security)
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict
SESSION_TIMEOUT=1800  # 30 minutes

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # Use 'live' for production

# JWT Configuration (if implemented)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRATION=86400

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security Configuration
BCRYPT_ROUNDS=12

# Firebase Admin (if using Firebase)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=path/to/firebase-service-account.json