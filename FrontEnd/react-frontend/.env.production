# Production Environment Configuration for SkillSync Application

# API Configuration
REACT_APP_API_BASE_URL=https://skillsync-api.production.com/api

# Security Configuration
REACT_APP_CSRF_ENABLED=true
REACT_APP_SECURE_MODE=production

# Firebase Configuration (Production values)
REACT_APP_FIREBASE_API_KEY=production_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=skillsync-prod.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=skillsync-prod
REACT_APP_FIREBASE_STORAGE_BUCKET=skillsync-prod.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=production_sender_id
REACT_APP_FIREBASE_APP_ID=production_app_id

# Payment Configuration (Production)
REACT_APP_PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
REACT_APP_PAYMENT_PUBLIC_KEY=production_payment_public_key

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DEBUG=false