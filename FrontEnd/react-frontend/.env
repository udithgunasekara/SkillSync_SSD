# Environment Configuration for SkillSync Application

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Security Configuration
REACT_APP_CSRF_ENABLED=true
REACT_APP_SECURE_MODE=development

# Firebase Configuration (Replace with your actual values)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Payment Configuration
REACT_APP_PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
REACT_APP_PAYMENT_PUBLIC_KEY=your_payment_public_key_here

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG=true